LOOP 
//------Loops for loop and while loop---

//--- for loops----
cout<<"\nCounting 1 to 5 with a for loop:" <<endl;
for(int i = 1; i<=5; i++) {
    cout<<i<< " ";
} 
    cout <<endl;

//----while loop---
cout<<"\nCounting down with a while loop: "<<endl;
int n = 5;
while (n > 0) {
    cout <<n<< " ";
    n--;
}
   cout<< endl;

//---do-while loop (runs at least once)---
cout<<" \ndo-while example: "<<endl;
int x = 0;
do {
    cout<< "x ="<< x << endl;
    x++;
}while(x <3);

//--- break and continue-----
cout<<"\nSkipping 3 using continue, stopping at 7 using break:" <<endl;
for(int i = 1, i<=10; i++) {
    if(i == 3) continue; //skip this interaction
    if(i == 7) break; // exit the loop entirely
    cout << i << " ";
}
  cout << endl;
